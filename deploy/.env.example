# Copy this file to .env (in this deploy/ folder) and fill it in. Never commit .env.

# From Cloudflare: Zero Trust > Networks > Tunnels > your tunnel > install connector (the long token)
TUNNEL_TOKEN=

# The repository the hub is served from, and which branch
